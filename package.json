{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "smartclinic-ai",
  "version": "1.0.0",
  "private": true,
  "description": "SmartClinic AI - clinic management system with a separated frontend (Next.js) and backend (Express + Supabase) architecture",
  "scripts": {
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "dev": "concurrently -k -n BACKEND,FRONTEND -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "start:frontend": "npm run start --prefix frontend",
    "start:backend": "npm run start --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}